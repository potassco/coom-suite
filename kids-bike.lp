domain("Wheel","W20").
domain("Bool","True").
domain("Bool","False").
integer("Wheel.size").
range("Wheel.size",14,20).
type("root","product").
type("root.color[0]","Color").
type("root.wheelSupport[0]","Bool").
type("root.frontWheel[0]","Wheel").
type("root.rearWheel[0]","Wheel").
